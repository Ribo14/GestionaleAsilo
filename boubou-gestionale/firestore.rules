rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regola definitiva, senza scadenza.
    // Consente lettura e scrittura SOLO agli utenti autenticati con Firebase Auth
    // (email + password creati nella console). Chiunque non sia loggato viene rifiutato:
    // questo blocca gli scanner automatici e chiude l'accesso pubblico al database.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
